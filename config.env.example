# Copier vers config.env puis adapter. config.env est ignore par git.
DOTS_USER="julien"
DOTS_HOSTNAME="obsidian"
DOTS_TIMEZONE="Europe/Paris"
DOTS_LOCALE="fr_FR.UTF-8"
DOTS_KEYMAP="fr"
# Niveau de micro-architecture des repos CachyOS : v4 (AVX-512, 7950X3D) ou v3
CACHYOS_ARCH_LEVEL="v4"
# Sortie ecran Hyprland vers la LG G3 (verifier avec `hyprctl monitors`)
DOTS_MONITOR="HDMI-A-1"

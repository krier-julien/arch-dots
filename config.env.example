# Copier vers config.env puis adapter. config.env est ignore par git.
DOTS_USER="julien"
DOTS_HOSTNAME="arch"
DOTS_TIMEZONE="Europe/Luxembourg"
# Langue systeme en anglais, formats europeens (dates, papier, mesures) et monnaie EUR
DOTS_LOCALE="en_US.UTF-8"
DOTS_LOCALE_FORMATS="en_GB.UTF-8"
DOTS_LOCALE_MONETARY="de_LU.UTF-8"
DOTS_KEYMAP="us"
# Tier des repos CachyOS : znver4 (Zen 4/5, recommande pour le 7950X3D), v4 ou v3.
# Le script officiel cachyos-repo.sh detecte le CPU ; cette valeur sert de verification.
CACHYOS_ARCH_LEVEL="znver4"
# Sortie ecran Hyprland vers la LG G3 (verifier avec `hyprctl monitors`)
DOTS_MONITOR="HDMI-A-1"
# Theme SDDM : "sddm-astronaut-theme" (paquet AUR) ou un theme qylock installe par la phase 2
# (ex : pixel-night-city, material-you, nier-automata, clockwork/orbital... voir docs/20-hyprland.md)
DOTS_SDDM_THEME="sddm-astronaut-theme"
# Version npm de nxapi (la presence Switch 2 demande une pre-release recente)
NXAPI_VERSION="1.6.1-next.254"

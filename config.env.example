# Copier vers config.env puis adapter. config.env est ignore par git.
DOTS_USER="julien"
DOTS_HOSTNAME="arch"
DOTS_TIMEZONE="Europe/Luxembourg"
# Langue systeme en anglais, formats europeens (dates, papier, mesures) et monnaie EUR
DOTS_LOCALE="en_US.UTF-8"
DOTS_LOCALE_FORMATS="en_GB.UTF-8"
DOTS_LOCALE_MONETARY="de_LU.UTF-8"
DOTS_KEYMAP="us"
# Tier des repos CachyOS : znver4 (Zen 4/5, recommande pour le 7950X3D), v4 ou v3.
# Le script officiel cachyos-repo.sh detecte le CPU ; cette valeur sert de verification.
CACHYOS_ARCH_LEVEL="znver4"
# Sortie ecran Hyprland vers la LG G3 (verifier avec `hyprctl monitors`)
DOTS_MONITOR="HDMI-A-1"
# Profondeur de couleur : 10 (SDR 10 bits, moins de banding ; HDMI 2.1 4K120 4:4:4 ok) ou 8
DOTS_BITDEPTH=10
# Theme SDDM : "sddm-astronaut-theme" (paquet AUR) ou un theme qylock installe par la phase 2
# (ex : pixel-night-city, material-you, nier-automata, clockwork/orbital... voir docs/20-hyprland.md)
DOTS_SDDM_THEME="sddm-astronaut-theme"
# Version npm de nxapi (la presence Switch 2 demande une pre-release recente)
NXAPI_VERSION="1.6.1-next.254"

# --- Stockage : second NVMe a ajouter au Btrfs racine (vide = un seul disque) ---
# Exemple : le SN850X 2 To si l'installation a ete faite sur le 1 To.
# Donnees en "single" (les deux capacites s'additionnent, ~3 To), metadonnees en raid1.
# ATTENTION : le disque est efface. Verifier avec `lsblk -o NAME,SIZE,MODEL,FSTYPE`.
DOTS_BTRFS_EXTRA_DEVICE=""
# Mettre a 1 pour autoriser l'effacement si le disque contient deja un systeme de fichiers
DOTS_BTRFS_WIPE=0

# --- Test en machine virtuelle (QEMU/KVM) : 1 = pas de NVIDIA, pas de capteurs, ecran "preferred"
DOTS_VM=0

# Entree Limine selectionnee au boot (numerotation Limine : 1 = groupe "Arch Linux", 2 = premier noyau
# du groupe, 3 = deuxieme...). Verifier l'ordre avec : sudo grep -E '^\s*/' /boot/limine.conf
DOTS_LIMINE_DEFAULT_ENTRY=2
DOTS_LIMINE_TIMEOUT=3

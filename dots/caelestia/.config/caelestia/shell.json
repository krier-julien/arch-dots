{
    "general": {
        "apps": {
            "terminal": [
                "foot"
            ],
            "audio": [
                "pwvucontrol"
            ],
            "playback": [
                "mpv"
            ],
            "explorer": [
                "thunar"
            ]
        },
        "idle": {
            "lockBeforeSleep": true,
            "inhibitWhenAudio": true,
            "timeouts": [
                {
                    "timeout": 900,
                    "idleAction": "lock",
                    "respectInhibitors": true
                }
            ]
        }
    },
    "bar": {
        "persistent": true
    },
    "services": {
        "weatherLocation": "Luxembourg",
        "useFahrenheit": false,
        "useTwelveHourClock": false,
        "gpuType": "Auto",
        "smartScheme": true,
        "defaultPlayer": "YouTube Music",
        "playerAliases": [
            {
                "from": "com.github.th_ch.youtube_music",
                "to": "YouTube Music"
            },
            {
                "from": "com.github.th-ch.youtube-music",
                "to": "YouTube Music"
            },
            {
                "from": "Pear Desktop",
                "to": "YouTube Music"
            }
        ]
    },
    "session": {
        "commands": {
            "logout": [
                "/usr/local/bin/session-exit",
                "logout"
            ],
            "shutdown": [
                "/usr/local/bin/session-exit",
                "poweroff"
            ],
            "hibernate": [
                "/usr/local/bin/session-exit",
                "hibernate"
            ],
            "reboot": [
                "/usr/local/bin/session-exit",
                "reboot"
            ]
        }
    }
}

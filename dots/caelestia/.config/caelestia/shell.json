{
    "general": {
        "apps": {
            "terminal": [
                "foot"
            ],
            "audio": [
                "pwvucontrol"
            ],
            "playback": [
                "mpv"
            ],
            "explorer": [
                "thunar"
            ]
        },
        "idle": {
            "lockBeforeSleep": true,
            "inhibitWhenAudio": true,
            "timeouts": [
                {
                    "timeout": 900,
                    "idleAction": "lock",
                    "respectInhibitors": true
                }
            ]
        }
    },
    "bar": {
        "persistent": true
    },
    "services": {
        "weatherLocation": "Luxembourg",
        "useFahrenheit": false,
        "useTwelveHourClock": false,
        "gpuType": "Auto",
        "smartScheme": true
    }
}

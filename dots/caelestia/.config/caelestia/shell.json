{
    "general": {
        "apps": {
            "terminal": ["foot"],
            "audio": ["pwvucontrol"],
            "playback": ["mpv"],
            "explorer": ["thunar"]
        },
        "idle": {
            "lockBeforeSleep": true,
            "inhibitWhenAudio": true,
            "timeouts": [
                { "timeout": 900,  "idleAction": "lock", "respectInhibitors": true },
                { "timeout": 1800, "idleAction": "dpms off", "returnAction": "dpms on" }
            ]
        }
    },
    "bar": {
        "persistent": true
    },
    "services": {
        "weatherLocation": "Luxembourg",
        "useFahrenheit": false,
        "useTwelveHourClock": false,
        "gpuType": "Auto",
        "smartScheme": true
    }
}

# Copier vers ~/.config/nxapi/presence.env (ignore par git), puis systemctl --user restart nxapi-presence
# NXAPI_USER : id (na_id) du compte Nintendo SECONDAIRE authentifie avec `nxapi nso auth`
#              (visible via `nxapi nso users`)
NXAPI_USER=
# NXAPI_FRIEND_NSAID : NSA id du compte PRINCIPAL (celui qui joue), ami du compte secondaire
#              (visible via `nxapi nso friends` depuis le compte secondaire)
NXAPI_FRIEND_NSAID=
# NXAPI_DISCORD_USER : id Discord a cibler si plusieurs clients Discord tournent (sinon laisser vide
#              et retirer l'option dans le service)
NXAPI_DISCORD_USER=

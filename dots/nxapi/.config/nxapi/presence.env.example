# Copier vers ~/.config/nxapi/presence.env (ignore par git), puis :
#   systemctl --user daemon-reload && systemctl --user restart nxapi-presence
#
# NXAPI_FRIEND_NSAID : NSA ID (16 hex) du compte PRINCIPAL, celui qui joue, ami du compte
#   secondaire authentifie avec `nxapi nso auth` (liste : `nxapi nso friends`)
NXAPI_FRIEND_NSAID=6a3756fd9acdec95
#
# Options facultatives, separees par des espaces :
#   --user <na_id>            compte Nintendo (secondaire) a utiliser si plusieurs sont authentifies (`nxapi nso users`)
#   --discord-user <id>       client Discord cible si plusieurs tournent
#   --show-play-time hour     format du temps de jeu (hidden, nintendo, approximate, hour, detailed...)
#   --friend-code SW-xxxx-xxxx-xxxx   afficher le code ami du compte principal
NXAPI_EXTRA_ARGS=--show-play-time approximate

[Unit]
Description=nxapi - Nintendo Switch presence to Discord (secondary account)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Secrets et identifiants hors du repo : ~/.config/nxapi/presence.env (voir presence.env.example)
EnvironmentFile=%h/.config/nxapi/presence.env
ExecStart=%h/.local/bin/nxapi nso presence --user ${NXAPI_USER} --friend-nsaid ${NXAPI_FRIEND_NSAID} --discord-preferred-user ${NXAPI_DISCORD_USER}
Restart=on-failure
RestartSec=30
Environment=NODE_ENV=production

[Install]
WantedBy=graphical-session.target

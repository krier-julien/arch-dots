# Variables exportees dans la session utilisateur par uwsm (toutes les apps, pas seulement
# celles lancees par Hyprland). Reprend l'env Caelestia + NVIDIA + HiDPI.

# ---- Themes (Caelestia) ----
export QT_QPA_PLATFORMTHEME='qtengine'
export QT_WAYLAND_DISABLE_WINDOWDECORATION='1'
export QT_AUTO_SCREEN_SCALE_FACTOR='1'

# ---- Backends des toolkits ----
export GDK_BACKEND='wayland,x11'
export QT_QPA_PLATFORM='wayland;xcb'
export SDL_VIDEODRIVER='wayland,x11,windows'
export CLUTTER_BACKEND='wayland'
export ELECTRON_OZONE_PLATFORM_HINT='auto'

# ---- XDG ----
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland

# ---- NVIDIA (RTX 4090, modules open) ----
export LIBVA_DRIVER_NAME=nvidia
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export NVD_BACKEND=direct

# ---- HiDPI (scale 2.0) ----
export GDK_SCALE=2
export XCURSOR_SIZE=24
export XCURSOR_THEME=Bibata-Modern-Classic
export STEAM_FORCE_DESKTOPUI_SCALING=2

# ---- Divers ----
export _JAVA_AWT_WM_NONREPARENTING=1
export EDITOR=micro
export BROWSER=brave-origin

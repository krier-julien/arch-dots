[Unit]
Description=Apply fixed pump/fan speeds via liquidctl
# Pas de systemd-udev-settle : il retarde tout le boot. Le script attend lui-meme les peripheriques (10 s max).
After=systemd-udevd.service local-fs.target
DefaultDependencies=yes

[Service]
Type=oneshot
ExecStart=/usr/local/bin/liquidctl-apply
RemainAfterExit=yes
# Redemarre si les peripheriques n'etaient pas encore la
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# /etc/default/limine : configuration de limine-entry-tool (limine-update).
# Genere par scripts/10-base.sh ; @@ROOT@@ est remplace par root=/rootflags= du systeme.
TARGET_OS_NAME="Arch Linux"
ESP_PATH="/boot"

KERNEL_CMDLINE[default]+="@@ROOT@@"
# NVIDIA : KMS + framebuffer sur le driver proprietaire (Wayland)
KERNEL_CMDLINE[default]+=" nvidia_drm.modeset=1 nvidia_drm.fbdev=1"
# CPU : amd-pstate actif (EPP), pas de zswap (zram a la place), pas de watchdog, split lock off
KERNEL_CMDLINE[default]+=" amd_pstate=active zswap.enabled=0 nowatchdog split_lock_detect=off"
KERNEL_CMDLINE[default]+=" quiet loglevel=3"

ENABLE_UKI=no
ENABLE_LIMINE_FALLBACK=yes
FIND_BOOTLOADERS=yes
BOOT_ORDER="*, *fallback, Snapshots"
MAX_SNAPSHOT_ENTRIES=5
SNAPSHOT_FORMAT_CHOICE=5
